{
  "name": "cloudstore",
  "type": "module",
  "version": "0.0.3",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "lint:rust:fix": "cargo clippy --fix --manifest-path src-tauri/Cargo.toml --all-targets --allow-dirty",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:rust:check": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "changelog": "changelogen --output CHANGELOG.md",
    "release": "bumpp"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@lobehub/icons-static-svg": "^1.102.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.104.4",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2",
    "@tauri-apps/plugin-updater": "^2",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "i18next": "^26.5.11",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.1.9",
    "react-resizable-panels": "^4.14.6",
    "react-router": "^8.4.0",
    "shadcn": "^4.22.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@eslint-react/eslint-plugin": "^5.28.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "bumpp": "^12.3.0",
    "changelogen": "^0.6.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
