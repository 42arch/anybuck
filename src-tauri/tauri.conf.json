{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cloudstore",
  "version": "0.0.3",
  "identifier": "com.starllow.cloudstore",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "cloudstore",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM1OUIzNzMyNENEMzM4QTEKUldTaE9OTk1NamViTld2Vmh5M2Vob0hsYXlHQW5jdXlRTk1UYnpvL2FkeE5KYVhnalZqNzQzSXEK",
      "endpoints": [
        "https://github.com/42arch/cloudstore/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}